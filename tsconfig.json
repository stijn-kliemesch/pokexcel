{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "office-js",
      "jest"
    ],
    "lib": [
      "DOM",
      "ESNext"
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules","dist"]
}


