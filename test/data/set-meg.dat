Type":true,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of *Zapdos (Fossil 15\/62)*. Also see *Normal Holo*.","preferredOrder":null,"cardVariantSortingOrder":2990},"244":{"id":244,"name":"Cosmos Holo (1999 Copyright)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This variant of *Zapdos (Fossil 15\/62)* was handed out exclusively to employees of Wizards of the Coast. It features a *Cosmos Holo* holographic pattern instead of the default *Galaxy* pattern. The *1999* copyright distinguishes it from the *Thunderstorm Gift Box* *1999-2000* copyright variant.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"263":{"id":263,"name":"Normal Holo (Gray Background Error)","isStandardSetType":true,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":"This is an error variant of *Zekrom (Black & White 114\/114)*. Also see *Normal Holo*.\r\n","preferredOrder":null,"cardVariantSortingOrder":2990},"264":{"id":264,"name":"WC Deck 2019 (Mind Blown: Shintaro Ito)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"265":{"id":265,"name":"WC Deck 2019 (Perfection: Henry Brand)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"266":{"id":266,"name":"WC Deck 2019 (Fire Box: Kaya Lichtleitner)","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":false,"hasQualifiers":true,"isCombined":false,"descriptionMd":null,"preferredOrder":nu