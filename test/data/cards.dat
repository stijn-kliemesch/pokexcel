    <div class="drawer-fullscreen-body">

              <div class="container">
      
      <div class="drawer-fullscreen-body-content">
        
    <div class="form-field">

      <label class="form-label" for="card-sort-by-select">Sort by</label>

      <select
        id="card-sort-by-select"
        class="card-display-option-select form-control"
        data-query-string-key="sortBy"
      >
                  <option
            value="cardNumber"
            selected          >
            Card number
          </option>
                  <option
            value="cardNameAsc"
                      >
            Card name (A-Z)
          </option>
                  <option
            value="cardNameDesc"
                      >
            Card name (Z-A)
          </option>
                  <option
            value="rarityDesc"
                      >
            Rarity (desc)
          </option>
                  <option
            value="rarityAsc"
                      >
            Rarity (asc)
          </option>
                  <option
            value="marketPriceDesc"
                      >
            Market price (desc)
          </option>
                  <option
            value="marketPriceAsc"
                      >
            Market price (asc)
          </option>
                  <option
            value="pokedexNumber"
                      >
            Pokédex number
          </option>
              </select>

    </div>

          <div class="form-field">

        <label class="form-label" for="release-date-order-select">From</label>

        <select
          id="release-date-order-select"
          class="card-display-option-select form-control"
          data-query-string-key="releaseDateOrder"
        >
                      <option
              value="newToOld"
              selected            >
              New to old
            </option>
                      <option
              value="oldToNew"
                          >
              Old to new
            </option>
                  </select>

      </div>
    
          <div class="form-field">

        <label class="form-label" for="cards-per-page-select">Show</label>

        <select
          id="cards-per-page-select"
          class="card-display-option-select form-control"
          data-query-string-key="cardsPerPage"
        >
                      <option
              value="30"
              selected            >
              30 cards
            </option>
                      <option
              value="60"
                          >
              60 cards
            </option>
                      <option
              value="120"
                          >
              120 cards
            </option>
                  </select>

      </div>
    
    <div class="form-field">

      <label class="form-label" for="card-display-as-select">Show</label>

      <select
        id="card-display-as-select"
        class="card-display-option-select form-control"
        data-query-string-key="displayAs"
      >
                  <option
            value="list"
                      >
            List
          </option>
                  <option
            value="images"
            selected          >
            Images
          </option>
              </select>

    </div>

        </div>

              </div>
      
