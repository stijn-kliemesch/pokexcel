efault variant.\n","preferredOrder":null,"cardVariantSortingOrder":null},"47":{"id":47,"name":"1999-2000 Copyright","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"This variant has *1999-2000* in the copyright text instead of the regular copyright date. It's exclusive to the *Base Set* expansion (also commonly called the *4th print*), the *Thunderstorm Gift Box* theme deck of the *Fossil* expansion, and the Australian red Pok\u00e9mon logo booster packs of the *Fossil* expansion.","preferredOrder":null,"cardVariantSortingOrder":null},"48":{"id":48,"name":"Cosmos Holo","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"This variant features a holographic pattern in the artwork that consists of dots and circles of different sizes.","preferredOrder":null,"cardVariantSortingOrder":null},"49":{"id":49,"name":"No e-Reader","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"This variant lacks the e-Reader design at the bottom of the card.\n\nThis variant only applies to cards that feature this design under normal circumstances.","preferredOrder":null,"cardVariantSortingOrder":null},"50":{"id":50,"name":"2000 Pikachu World Collection","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":"This variant features a Pikachu tail stamp on the middle left of the card.\r\n","preferredOrder":null,"cardVariantSortingOrder":null},"52":{"id":52,"name":"Toys \"R\" Us","isStandardSetType":false,"isParallelSetType":false,"isFirstEditionPrint":false,"isGeneric":true,"hasQualifiers":false,"isCombined":false,"descriptionMd":null,"preferredOrder":null,"cardVariantSortingOrder":null},"